from tkinter import *

# setup
root = Tk()
root.title("paint !")
frame = Frame(root)
frame.pack()

# canvas
c = Canvas(root, bg='white', height=1000, width=1000)
c.pack()


COLOUR = 'black'
SIZE = 10
colours = ['red', 'orange', 'yellow', 'green',
           'blue', 'purple', 'magenta', 'black', 'white']


class ColourButton():
    def __init__(self, colour):
        self.colour = colour
        self.Button = Button(frame, bg=colour, command=self.update)

    def update(self):
        global COLOUR
        COLOUR = self.colour





def draw_circle(event):
    c.create_oval(event.x, event.y, event.x + SIZE.get(),
                    event.y + SIZE.get(), fill=COLOUR, outline=COLOUR, tags=[COLOUR])
    
def clear_canvas():
    c.delete('all')


colours = ['red', 'orange', 'yellow', 'green', 'blue', 'purple', 'black']
for i in range(len(colours)):
    x = ColourButton(colours[i])
    x.Button.grid(row=0, column=i)

clear_button = Button(frame, text='clear !!', command= clear_canvas)
clear_button.grid(row = 0, column = i + 1)

SIZE = IntVar()
scalebar = Scale(frame, variable = SIZE, bg = 'grey', tickinterval=1,  resolution = 1, orient = HORIZONTAL, from_ = 1, to = 10)
scalebar.grid(row = 0, column = i + 2)#, sticky = 'news')


# To fetch current value use variable var or
#SIZE = scalebar.get() * 10

c.bind("<B1-Motion>", draw_circle) # must be bound to C so scale doesn't cause drawing on canvas
root.bind("<q>", quit)
root.mainloop()
